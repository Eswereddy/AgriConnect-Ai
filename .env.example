# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GOOGLE_MAPS_PLATFORM_KEY: Required for interactive Map views, GPS picker, and Place services.
GOOGLE_MAPS_PLATFORM_KEY=

# ---------------------------------------------
# Production hardening (auth, database, monitoring)
# ---------------------------------------------

# JWT_SECRET: Signs login session tokens (server/auth.ts). REQUIRED for any
# real deployment - without it, every server restart logs everyone out, and
# the fallback secret is not safe to rely on. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# DATABASE_PATH: Where the SQLite database file (users, audit log, error log)
# is stored. Optional - defaults to ./data/agriconnect.db. Point this at a
# persistent volume/disk if your host wipes the filesystem between deploys.
DATABASE_PATH=

# DATA_DIR / LOG_DIR: Optional overrides for where the database directory and
# ./logs/*.log files are created. Rarely needed - only if you want them
# somewhere other than the project root (e.g. a mounted persistent disk).
DATA_DIR=
LOG_DIR=

# SENTRY_DSN: Optional. If set (and `npm install @sentry/node` has been run),
# server-side errors are also sent to Sentry in addition to the local
# database/log files. Leave blank to just use local logging.
SENTRY_DSN=

# VITE_SENTRY_DSN: Optional. Same idea as SENTRY_DSN, but for the browser
# (requires `npm install @sentry/react`). Leave blank to log client errors
# to the backend instead (POST /api/client-error).
VITE_SENTRY_DSN=

# DEMO_MODE / VITE_DEMO_MODE: Set BOTH to "true" to disable login entirely -
# every /api/* endpoint and the login screen itself become open to anyone.
# Meant for short-lived pitch/investor demos only. Leave unset (the default)
# for real usage. DEMO_MODE is read by the server, VITE_DEMO_MODE by the
# frontend build - they must be set together or the two won't agree.
DEMO_MODE=
VITE_DEMO_MODE=

